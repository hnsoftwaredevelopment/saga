<Window x:Class="EbookManager.App.Views.DuplicateExclusionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc DuplicateExclusionsTitle}"
        Width="920"
        Height="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{loc:Loc DuplicateExclusionsTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc DuplicateExclusionsDescription}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Margin="0,8,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <Run Text="{Binding ExclusionCount, Mode=OneWay}" />
        <Run Text="{loc:Loc DuplicateExclusionsCountSuffix}" />
      </TextBlock>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="{loc:Loc RestoreSelectedDuplicateExclusions}"
              Command="{Binding RestoreSelectedCommand}"
              MinWidth="150"
              Margin="0,0,8,0" />
      <Button Content="{loc:Loc RestoreAllDuplicateExclusions}"
              Command="{Binding RestoreAllCommand}"
              MinWidth="130"
              Margin="0,0,8,0" />
      <Button Content="{loc:Loc Close}"
              MinWidth="90"
              Click="CloseClicked" />
    </StackPanel>

    <Grid>
      <TextBlock Text="{loc:Loc DuplicateExclusionsNone}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasRows}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <DataGrid x:Name="DuplicateExclusionsGrid"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                SelectionChanged="DuplicateExclusionsSelectionChanged">
        <DataGrid.Style>
          <Style TargetType="DataGrid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasRows}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.Style>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc FirstBook}" Binding="{Binding FirstBookTitle}" Width="220" />
          <DataGridTextColumn Header="{loc:Loc FirstBookAuthors}" Binding="{Binding FirstBookAuthors}" Width="180" />
          <DataGridTextColumn Header="{loc:Loc SecondBook}" Binding="{Binding SecondBookTitle}" Width="220" />
          <DataGridTextColumn Header="{loc:Loc SecondBookAuthors}" Binding="{Binding SecondBookAuthors}" Width="180" />
          <DataGridTextColumn Header="{loc:Loc DateAdded}" Binding="{Binding CreatedAt, StringFormat=d}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
