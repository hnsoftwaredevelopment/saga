<Window x:Class="EbookManager.App.Views.SeriesNumberWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:EbookManager.App.Localization" Title="{loc:Loc SeriesNumberChange}"
 Width="580" Height="450" MinWidth="460" MinHeight="350" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="SaveNumberButton" Content="{loc:Loc SeriesNumberChange}" IsDefault="True" IsEnabled="{Binding CanSave}" Click="SaveClicked" MinWidth="120" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc SeriesNumberChange}" />
   <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="90" AutomationProperties.Name="{loc:Loc Cancel}" />
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="{loc:Loc SeriesNumberChange}" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,4" />
    <TextBlock Text="{Binding Authors}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Series}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,12" />
    <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Label Content="{loc:Loc SeriesNumber}" Target="{Binding ElementName=NumberBox}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,0,0,4" />
    <TextBox x:Name="NumberBox" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SeriesNumber}" />
    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{Binding DuplicateMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
