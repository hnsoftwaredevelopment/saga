<Window x:Class="EbookManager.App.Views.MetadataQualityLanguageRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc MetadataQualityLanguageRepairTitle}"
        Width="520"
        Height="300"
        MinWidth="440"
        MinHeight="260"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{loc:Loc MetadataQualityLanguageRepairTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc MetadataQualityLanguageRepairDescription}"
                 Margin="0,5,0,16"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="CancelLanguageRepairButton"
              Content="{loc:Loc Cancel}"
              MinWidth="90"
              IsCancel="True"
              Focusable="True"
              AutomationProperties.Name="{loc:Loc Cancel}" />
      <Button x:Name="SaveLanguageRepairButton"
              Content="{loc:Loc Save}"
              MinWidth="90"
              Margin="8,0,0,0"
              IsDefault="True"
              IsEnabled="{Binding CanSave}"
              Focusable="True"
              Click="SaveClicked"
              AutomationProperties.Name="{loc:Loc MetadataQualityLanguageRepairSave}" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="{loc:Loc Title}"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding BookTitle}"
                 Margin="0,4,0,14"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Text="{loc:Loc Language}"
                 FontWeight="SemiBold" />
      <ComboBox x:Name="LanguageInput"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                DisplayMemberPath="DisplayText"
                IsEditable="False"
                IsTextSearchEnabled="True"
                TextSearch.TextPath="DisplayText"
                MaxDropDownHeight="220"
                Margin="0,4,0,6"
                AutomationProperties.Name="{loc:Loc MetadataQualityLanguageRepairInput}" />
      <TextBlock Text="{loc:Loc MetadataQualityLanguageRepairHelp}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
  </DockPanel>
</Window>
