<Window x:Class="EbookManager.App.Views.SeriesRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{Binding ActionLabel}" Width="560" Height="340" MinWidth="460" MinHeight="320"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
  <Window.Resources><BooleanToVisibilityConverter x:Key="ShowSplitBooks" /></Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="SaveRenameButton" Content="{Binding ActionLabel}" IsDefault="True" IsEnabled="{Binding CanSave}" Click="RenameClicked" MinWidth="110" Margin="0,0,8,0" AutomationProperties.Name="{Binding ActionLabel}" />
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="90" AutomationProperties.Name="{loc:Loc Cancel}" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="{loc:Loc SeriesRenameOriginal}" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"><TextBlock Text="{Binding OriginalName}" TextWrapping="Wrap" FontWeight="SemiBold" /></ScrollViewer>
      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,16" />
      <Label Content="{Binding NameLabel}" Target="{Binding ElementName=NewNameBox}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,0,0,4" />
      <TextBox x:Name="NewNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" TextChanged="MoveSearchChanged"
               PreviewKeyDown="DestinationKeyDown" AutomationProperties.Name="{Binding NameLabel}" />
      <StackPanel Visibility="{Binding IsSplit, Converter={StaticResource ShowSplitBooks}}">
        <ListBox x:Name="MoveDestinations" MaxHeight="102" Margin="0,4,0,0" DisplayMemberPath="Name"
                 PreviewKeyDown="DestinationKeyDown" PreviewMouseLeftButtonUp="DestinationClicked"
                 Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowSplitBooks}}"
                 Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="{loc:Loc SeriesMoveExisting}" />
        <Button x:Name="MoreDestinationsButton" Content="{loc:Loc SeriesLoadMore}" Click="MoreDestinationsClicked" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,4,0,0" />
        <Button x:Name="UseNewSeriesButton" Content="{loc:Loc SeriesMoveUseNew}" Click="UseNewSeriesClicked" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,4,0,0" />
        <TextBlock x:Name="DestinationStatus" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="OverlapText" Text="{Binding OverlapMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>
      </StackPanel>
      <DataGrid x:Name="SplitBooksGrid" Visibility="{Binding IsSplit, Converter={StaticResource ShowSplitBooks}}" ItemsSource="{Binding SplitBooks}"
                MaxHeight="200" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                EnableRowVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="None"
                Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="{loc:Loc SeriesBooks}">
        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Padding" Value="6" /></Style></DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style></DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc Title}" Binding="{Binding Title}" Width="*" />
          <DataGridTextColumn Header="{loc:Loc SeriesNumber}" Binding="{Binding Number}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
