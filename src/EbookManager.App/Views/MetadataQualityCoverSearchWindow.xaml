<Window x:Class="EbookManager.App.Views.MetadataQualityCoverSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        xmlns:converters="clr-namespace:EbookManager.App.Converters"
        Title="{loc:Loc MetadataQualityCoverSearchTitle}"
        Width="920"
        Height="680"
        MinWidth="660"
        MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Loaded="WindowLoaded"
        Closed="WindowClosed"
        PreviewKeyDown="WindowPreviewKeyDown">
  <Window.Resources>
    <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:Loc MetadataQualityCoverSearchTitle}"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc MetadataQualityCoverSearchDescription}"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Text="{Binding BookTitle}"
                 Margin="0,8,0,0"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock Text="{Binding StatusMessage}"
                 Margin="0,0,0,8"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc Cancel}"
                MinWidth="90"
                IsCancel="True"
                AutomationProperties.Name="{loc:Loc Cancel}" />
        <Button x:Name="UseCoverButton"
                Content="{loc:Loc MetadataQualityUseCover}"
                MinWidth="120"
                Margin="8,0,0,0"
                IsDefault="True"
                IsEnabled="{Binding CanUseCover}"
                Click="UseCoverClicked"
                AutomationProperties.Name="{loc:Loc MetadataQualityUseCover}" />
      </StackPanel>
    </StackPanel>

    <Grid>
      <ProgressBar Height="4"
                   VerticalAlignment="Top"
                   IsIndeterminate="True">
        <ProgressBar.Style>
          <Style TargetType="ProgressBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ProgressBar.Style>
      </ProgressBar>

      <ListBox x:Name="CoverCandidates"
               ItemsSource="{Binding Candidates}"
               SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
               Margin="0,12,0,0"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="CoverCandidateDoubleClicked"
               AutomationProperties.Name="{loc:Loc MetadataQualityCoverSearchResults}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel IsItemsHost="True" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="160">
              <Border Height="220"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
                <Image Source="{Binding PreviewBytes, Converter={StaticResource ByteArrayToImageSourceConverter}, ConverterParameter=320}"
                       Stretch="Uniform"
                       AutomationProperties.Name="{Binding Title}" />
              </Border>
              <TextBlock Text="{Binding Title}"
                         Margin="0,6,0,0"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Title}" />
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                <Run Text="{Binding Width}" /><Run Text=" × " /><Run Text="{Binding Height}" />
              </TextBlock>
              <TextBlock Text="{Binding Source}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</Window>
