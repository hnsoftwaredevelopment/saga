<Window x:Class="EbookManager.App.Views.TagRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc TagRename}" Width="560" Height="340" MinWidth="460" MinHeight="320"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:Loc TagRename}" IsDefault="True" IsEnabled="{Binding CanSave}" Click="RenameClicked" MinWidth="110" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc TagRename}" />
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="90" AutomationProperties.Name="{loc:Loc Cancel}" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="{loc:Loc TagRenameOriginal}" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"><TextBlock Text="{Binding OriginalName}" TextWrapping="Wrap" FontWeight="SemiBold" /></ScrollViewer>
      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,16" />
      <Label Content="{loc:Loc TagRenameNew}" Target="{Binding ElementName=NewNameBox}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,0,0,4" />
      <TextBox x:Name="NewNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc TagRenameNew}" />
      <TextBlock Text="{loc:Loc TagRenameInvalid}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
