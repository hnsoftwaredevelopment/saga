<Window x:Class="EbookManager.App.Views.MetadataQualityTitleAuthorRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc MetadataQualityTitleAuthorRepairTitle}"
        Width="560"
        Height="440"
        MinWidth="460"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="SingleSwapPreview" TargetType="ScrollViewer">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBulk}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BulkSwapPreview" TargetType="DockPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBulk}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{loc:Loc MetadataQualityTitleAuthorRepairTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Margin="0,5,0,16"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="{loc:Loc MetadataQualityTitleAuthorRepairDescription}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBulk}" Value="True">
                <Setter Property="Text" Value="{loc:Loc MetadataQualityTitleAuthorRepairBulkHelp}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="CancelTitleAuthorRepairButton"
              Content="{loc:Loc Cancel}"
              MinWidth="90"
              IsCancel="True"
              Focusable="True"
              AutomationProperties.Name="{loc:Loc Cancel}" />
      <Button x:Name="ConfirmTitleAuthorRepairButton"
              MinWidth="110"
              Margin="8,0,0,0"
              IsDefault="True"
              IsEnabled="{Binding CanConfirm}"
              Focusable="True"
              Click="ConfirmClicked"
              AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="{loc:Loc MetadataQualityTitleAuthorRepairConfirm}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBulk}" Value="True">
                <Setter Property="Content" Value="{Binding BulkConfirmText}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </StackPanel>

    <Grid>
    <DockPanel Style="{StaticResource BulkSwapPreview}">
      <TextBlock DockPanel.Dock="Top" Text="{Binding BulkContext}" Margin="0,0,0,12"
                 FontWeight="SemiBold" TextWrapping="Wrap" />
      <ListBox x:Name="SwapPreviews"
               ItemsSource="{Binding Previews}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               HorizontalContentAlignment="Stretch"
               Focusable="True"
               AutomationProperties.Name="{loc:Loc MetadataQualityTitleAuthorRepairBulkPreview}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="8">
              <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <CheckBox Content="{loc:Loc MetadataQualityTitleAuthorRepairBulkChoose}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanRepair}" Focusable="True" Margin="0,8"
                        AutomationProperties.Name="{Binding CurrentTitle}" />
              <TextBlock Text="{loc:Loc MetadataQualityTitleAuthorRepairBulkUnavailable}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CanRepair}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="{loc:Loc MetadataQualityTitleAuthorRepairCurrent}" Margin="0,0,6,0">
                  <StackPanel Margin="8">
                    <TextBlock Text="{loc:Loc Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentTitle}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBlock Text="{loc:Loc Authors}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentAuthor}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="{loc:Loc MetadataQualityTitleAuthorRepairAfter}" Margin="6,0,0,0">
                  <StackPanel Margin="8">
                    <TextBlock Text="{loc:Loc Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NewTitle}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBlock Text="{loc:Loc Authors}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NewAuthor}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </GroupBox>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <ScrollViewer Style="{StaticResource SingleSwapPreview}" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="{loc:Loc MetadataQualityTitleAuthorRepairCurrent}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc Title}" FontWeight="SemiBold" Margin="0,0,14,8" />
            <TextBlock x:Name="CurrentTitleValue"
                       Grid.Column="1"
                       Text="{Binding CurrentTitle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{loc:Loc Authors}" FontWeight="SemiBold" Margin="0,0,14,0" />
            <TextBlock x:Name="CurrentAuthorValue"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding CurrentAuthor}"
                       TextWrapping="Wrap" />
          </Grid>
        </GroupBox>

        <TextBlock Text="↓"
                   Margin="0,8"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   AutomationProperties.Name="{loc:Loc MetadataQualityTitleAuthorRepairAfter}" />

        <GroupBox Header="{loc:Loc MetadataQualityTitleAuthorRepairAfter}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc Title}" FontWeight="SemiBold" Margin="0,0,14,8" />
            <TextBlock x:Name="NewTitleValue"
                       Grid.Column="1"
                       Text="{Binding NewTitle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{loc:Loc Authors}" FontWeight="SemiBold" Margin="0,0,14,0" />
            <TextBlock x:Name="NewAuthorValue"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding NewAuthor}"
                       TextWrapping="Wrap" />
          </Grid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
