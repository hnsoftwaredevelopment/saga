<Window x:Class="EbookManager.App.Views.MetadataQualityTitleAuthorRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc MetadataQualityTitleAuthorRepairTitle}"
        Width="560"
        Height="440"
        MinWidth="460"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{loc:Loc MetadataQualityTitleAuthorRepairTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc MetadataQualityTitleAuthorRepairDescription}"
                 Margin="0,5,0,16"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="CancelTitleAuthorRepairButton"
              Content="{loc:Loc Cancel}"
              MinWidth="90"
              IsCancel="True"
              Focusable="True"
              AutomationProperties.Name="{loc:Loc Cancel}" />
      <Button x:Name="ConfirmTitleAuthorRepairButton"
              Content="{loc:Loc MetadataQualityTitleAuthorRepairConfirm}"
              MinWidth="110"
              Margin="8,0,0,0"
              IsDefault="True"
              Focusable="True"
              Click="ConfirmClicked"
              AutomationProperties.Name="{loc:Loc MetadataQualityTitleAuthorRepairConfirm}" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="{loc:Loc MetadataQualityTitleAuthorRepairCurrent}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc Title}" FontWeight="SemiBold" Margin="0,0,14,8" />
            <TextBlock x:Name="CurrentTitleValue"
                       Grid.Column="1"
                       Text="{Binding CurrentTitle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{loc:Loc Authors}" FontWeight="SemiBold" Margin="0,0,14,0" />
            <TextBlock x:Name="CurrentAuthorValue"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding CurrentAuthor}"
                       TextWrapping="Wrap" />
          </Grid>
        </GroupBox>

        <TextBlock Text="↓"
                   Margin="0,8"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   AutomationProperties.Name="{loc:Loc MetadataQualityTitleAuthorRepairAfter}" />

        <GroupBox Header="{loc:Loc MetadataQualityTitleAuthorRepairAfter}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc Title}" FontWeight="SemiBold" Margin="0,0,14,8" />
            <TextBlock x:Name="NewTitleValue"
                       Grid.Column="1"
                       Text="{Binding NewTitle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{loc:Loc Authors}" FontWeight="SemiBold" Margin="0,0,14,0" />
            <TextBlock x:Name="NewAuthorValue"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding NewAuthor}"
                       TextWrapping="Wrap" />
          </Grid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
