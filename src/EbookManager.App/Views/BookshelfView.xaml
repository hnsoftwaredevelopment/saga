<UserControl x:Class="EbookManager.App.Views.BookshelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EbookManager.App.Controls"
             xmlns:converters="clr-namespace:EbookManager.App.Converters"
             xmlns:loc="clr-namespace:EbookManager.App.Localization"
             AllowDrop="True" PreviewMouseLeftButtonDown="BookPreviewMouseDown" PreviewKeyDown="BookPreviewKeyDown">
  <UserControl.Resources>
    <converters:LibraryGroupHeaderTextConverter x:Key="LibraryGroupHeaderTextConverter" />
    <Style x:Key="BookTileContainerStyle" TargetType="ListBoxItem">
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border BorderThickness="1" CornerRadius="14" Margin="1">
          <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
          <ContentPresenter />
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="BookTileTemplate">
      <Border Width="150"
              Margin="8"
              Padding="10"
              Background="{DynamicResource PanelBackgroundBrush}"
              CornerRadius="14" BorderThickness="2">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
          <Border Height="190"
                  Background="#FFE2E8F0"
                  CornerRadius="10"
                  Margin="0,0,0,10">
            <Grid>
              <TextBlock Text="{loc:Loc Cover}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <controls:AsyncCoverImage SourcePath="{Binding CoverPath}"
                                        DecodePixelWidth="220"
                                        Stretch="UniformToFill" />
            </Grid>
          </Border>
          <controls:HighlightedTextBlock HighlightedText="{Binding Title}"
                                         SearchText="{Binding SearchText}"
                                         HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"
                                         MaxHeight="40"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
          <controls:HighlightedTextBlock HighlightedText="{Binding Authors}"
                                         SearchText="{Binding SearchText}"
                                         HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                         TextWrapping="Wrap"
                                         MaxHeight="40"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="BookshelfGroupNodeTemplate">
      <StackPanel Margin="0,0,0,10">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Expanded="GroupExpanderExpanded"
                  Content="{Binding}">
          <Expander.Style>
            <Style TargetType="Expander">
              <Setter Property="ContentTemplate" Value="{x:Null}" />
              <Style.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter Property="ContentTemplate" Value="{DynamicResource BookshelfGroupContentTemplate}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Expander.Style>
          <Expander.Header>
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14,8"
                    Margin="10,10,10,0">
              <TextBlock FontWeight="SemiBold"
                         FontSize="16"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource LibraryGroupHeaderTextConverter}">
                    <Binding Path="Header" />
                    <Binding Path="BookCount" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Border>
          </Expander.Header>
        </Expander>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BookshelfGroupContentTemplate">
      <StackPanel Margin="22,4,0,0">
        <ListBox ItemsSource="{Binding Groups}"
                 ItemTemplate="{StaticResource BookshelfGroupNodeTemplate}"
                 BorderThickness="0"
                 Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 controls:MouseWheelScrollAssist.BubbleToParent="True" />
        <ListBox ItemsSource="{Binding Books}"
                 ItemTemplate="{StaticResource BookTileTemplate}"
                 ItemContainerStyle="{StaticResource BookTileContainerStyle}" SelectionMode="Extended"
                 BorderThickness="0"
                 Background="Transparent"
                 AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 controls:MouseWheelScrollAssist.BubbleToParent="True">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:VirtualizingWrapPanel IsItemsHost="True"
                                               ItemWidth="170"
                                               ItemHeight="285" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="10,0,10,8">
      <WrapPanel>
        <TextBlock VerticalAlignment="Center" Margin="0,0,16,6" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite"><Run Text="{loc:Loc MetadataMultiEditSelectedBooks}" /><Run Text=": " /><Run Text="{Binding SelectedBookCount, Mode=OneWay}" /></TextBlock>
        <Button Content="{loc:Loc MetadataMultiEditTitle}" Command="{Binding ShowMetadataMultiEditCommand}" Margin="0,0,0,6" AutomationProperties.Name="{loc:Loc MetadataMultiEditTitle}" />
      </WrapPanel>
      <TextBlock Text="{loc:Loc BookshelfSelectionHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
    </StackPanel>
    <ListBox x:Name="BookshelfBooksList"
             Grid.Row="1"
             ItemsSource="{Binding BookshelfVisibleBooksSource}"
             ItemTemplate="{StaticResource BookTileTemplate}"
             ItemContainerStyle="{StaticResource BookTileContainerStyle}" SelectionMode="Extended"
             BorderThickness="0"
             Background="Transparent"
             AllowDrop="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True">
      <ListBox.Style>
        <Style TargetType="ListBox">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBookshelfGrouped}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.Style>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <controls:VirtualizingWrapPanel IsItemsHost="True"
                                           ItemWidth="170"
                                           ItemHeight="285" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <ListBox x:Name="BookshelfGroupsList"
             Grid.Row="1"
             ItemsSource="{Binding BookshelfGroupedLibraryNodesSource}"
             ItemTemplate="{StaticResource BookshelfGroupNodeTemplate}"
             BorderThickness="0"
             Background="Transparent"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.CanContentScroll="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Style>
        <Style TargetType="ListBox">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBookshelfGrouped}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.Style>
    </ListBox>
  </Grid>
</UserControl>
