<UserControl x:Class="EbookManager.App.Views.BookshelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EbookManager.App.Controls"
             xmlns:converters="clr-namespace:EbookManager.App.Converters"
             xmlns:loc="clr-namespace:EbookManager.App.Localization"
             AllowDrop="True">
  <UserControl.Resources>
    <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
    <converters:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
    <converters:LibraryGroupHeaderTextConverter x:Key="LibraryGroupHeaderTextConverter" />
    <DataTemplate x:Key="BookTileTemplate">
      <Border Width="150"
              Margin="10"
              Padding="10"
              Background="{DynamicResource PanelBackgroundBrush}"
              CornerRadius="14">
        <StackPanel>
          <Border Height="190"
                  Background="#FFE2E8F0"
                  CornerRadius="10"
                  Margin="0,0,0,10">
            <Grid>
              <TextBlock Text="{loc:Loc Cover}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Image Source="{Binding CoverPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=220}"
                     Stretch="UniformToFill" />
            </Grid>
          </Border>
          <controls:HighlightedTextBlock HighlightedText="{Binding Title}"
                                         SearchText="{Binding SearchText}"
                                         HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"
                                         MaxHeight="40"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
          <controls:HighlightedTextBlock HighlightedText="{Binding Authors}"
                                         SearchText="{Binding SearchText}"
                                         HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                         TextWrapping="Wrap"
                                         MaxHeight="40"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="BookshelfGroupNodeTemplate">
      <StackPanel Margin="0,0,0,10">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Content="{Binding}">
          <Expander.Style>
            <Style TargetType="Expander">
              <Setter Property="ContentTemplate" Value="{x:Null}" />
              <Style.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter Property="ContentTemplate" Value="{DynamicResource BookshelfGroupContentTemplate}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Expander.Style>
          <Expander.Header>
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14,8"
                    Margin="10,10,10,0">
              <TextBlock FontWeight="SemiBold"
                         FontSize="16"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource LibraryGroupHeaderTextConverter}">
                    <Binding Path="Header" />
                    <Binding Path="BookCount" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Border>
          </Expander.Header>
        </Expander>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BookshelfGroupContentTemplate">
      <StackPanel Margin="22,4,0,0">
        <ListBox ItemsSource="{Binding Groups}"
                 ItemTemplate="{StaticResource BookshelfGroupNodeTemplate}"
                 BorderThickness="0"
                 Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 controls:MouseWheelScrollAssist.BubbleToParent="True" />
        <ListBox ItemsSource="{Binding Books}"
                 SelectedItem="{Binding DataContext.SelectedBook, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                 ItemTemplate="{StaticResource BookTileTemplate}"
                 BorderThickness="0"
                 Background="Transparent"
                 AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 controls:MouseWheelScrollAssist.BubbleToParent="True">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel IsItemsHost="True" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <ListBox ItemsSource="{Binding VisibleBooks}"
             SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
             ItemTemplate="{StaticResource BookTileTemplate}"
             BorderThickness="0"
             Background="Transparent"
             AllowDrop="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Style>
        <Style TargetType="ListBox">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBookshelfGrouped}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.Style>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <ListBox ItemsSource="{Binding GroupedLibraryNodes}"
             ItemTemplate="{StaticResource BookshelfGroupNodeTemplate}"
             BorderThickness="0"
             Background="Transparent"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.CanContentScroll="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Style>
        <Style TargetType="ListBox">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBookshelfGrouped}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.Style>
    </ListBox>
  </Grid>
</UserControl>
