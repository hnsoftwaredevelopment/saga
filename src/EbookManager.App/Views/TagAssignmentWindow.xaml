<Window x:Class="EbookManager.App.Views.TagAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{Binding Title}" Width="600" Height="410" MinWidth="460" MinHeight="330"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanVisibility" /></Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ApplyButton" Content="{Binding ConfirmText}" IsDefault="True" IsEnabled="{Binding CanApply}" Click="ApplyClicked" MinWidth="110" Margin="0,0,8,0" AutomationProperties.Name="{Binding ConfirmText}" />
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="90" AutomationProperties.Name="{loc:Loc Cancel}" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{loc:Loc TagRenameOriginal}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"><TextBlock Text="{Binding OriginalName}" TextWrapping="Wrap" FontWeight="SemiBold" /></ScrollViewer>
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Visibility="{Binding HasTargetName, Converter={StaticResource BooleanVisibility}}">
          <Label Content="{loc:Loc TagChangeTarget}" Target="{Binding ElementName=NewNameBox}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,0,0,4" />
          <TextBox x:Name="NewNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc TagChangeTarget}" />
          <TextBlock Text="{loc:Loc TagRenameInvalid}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsSplit, Converter={StaticResource BooleanVisibility}}">
          <Label Content="{loc:Loc TagSplitTargets}" Target="{Binding ElementName=SplitNamesBox}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,0,0,4" />
          <TextBox x:Name="SplitNamesBox" Text="{Binding SplitText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="64" MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc TagSplitTargets}" />
          <TextBlock Text="{loc:Loc TagSplitRules}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,10" />
          <TextBlock Text="{loc:Loc TagSplitPreview}" FontWeight="SemiBold" />
          <ScrollViewer MaxHeight="74" VerticalScrollBarVisibility="Auto" Margin="0,2,0,10">
            <TextBlock x:Name="SplitPreviewText" Text="{Binding SplitPreview}" TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBlock Text="{loc:Loc TagSelectedBookTitles}" FontWeight="SemiBold" />
          <ListBox x:Name="SplitBooksList" ItemsSource="{Binding SplitBooks}" DisplayMemberPath="Title" MaxHeight="112" Margin="0,4,0,0"
                   Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{loc:Loc TagSelectedBookTitles}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
