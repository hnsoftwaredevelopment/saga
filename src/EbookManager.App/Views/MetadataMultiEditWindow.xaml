<Window x:Class="EbookManager.App.Views.MetadataMultiEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EbookManager.App.Converters"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        xmlns:syncinput="clr-namespace:Syncfusion.Windows.Controls.Input;assembly=Syncfusion.SfInput.WPF"
        Title="{loc:Loc MetadataMultiEditTitle}"
        Width="520"
        Height="680"
        MinWidth="480"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <converters:CustomMetadataFieldTypeToLocalizedStringConverter x:Key="CustomMetadataFieldTypeToLocalizedStringConverter" />
    <converters:ReadingStatusToLocalizedStringConverter x:Key="ReadingStatusToLocalizedStringConverter" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{loc:Loc MetadataMultiEditTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="0,4,0,0">
        <Run Text="{loc:Loc MetadataMultiEditSelectedBooks}" />
        <Run Text=": " />
        <Run Text="{Binding SelectedBookCount, Mode=OneWay}" />
      </TextBlock>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{loc:Loc MetadataMultiEditHelp}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16" />

        <CheckBox Content="{loc:Loc Authors}"
                  IsChecked="{Binding UpdateAuthors}"
                  Margin="0,0,0,4" />
        <TextBox Text="{Binding AuthorsText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc MetadataMultiEditSemicolonTooltip}"
                 Margin="22,0,0,12" />

        <CheckBox Content="{loc:Loc Series}"
                  IsChecked="{Binding UpdateSeries}"
                  Margin="0,0,0,4" />
        <TextBox Text="{Binding SeriesText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="22,0,0,12" />

        <CheckBox Content="{loc:Loc Tags}"
                  IsChecked="{Binding UpdateTags}"
                  Margin="0,0,0,4" />
        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc MetadataMultiEditSemicolonTooltip}"
                 Margin="22,0,0,12" />

        <CheckBox Content="{loc:Loc Language}"
                  IsChecked="{Binding UpdateLanguage}"
                  Margin="0,0,0,4" />
        <TextBox Text="{Binding LanguageText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="22,0,0,12" />

        <CheckBox Content="{loc:Loc Status}"
                  IsChecked="{Binding UpdateStatus}"
                  Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding AvailableReadingStatuses}"
                  SelectedItem="{Binding Status}"
                  Margin="22,0,0,12">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource ReadingStatusToLocalizedStringConverter}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Margin="0,8,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasCustomFields}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{loc:Loc CustomMetadataFields}"
                     FontWeight="SemiBold"
                     FontSize="15"
                     Margin="0,8,0,8" />
          <ItemsControl ItemsSource="{Binding CustomFields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,12">
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Type, Converter={StaticResource CustomMetadataFieldTypeToLocalizedStringConverter}}"
                               DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="8,0,0,0" />
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding UpdateValue, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="SemiBold" />
                  </DockPanel>
                  <Grid Margin="22,0,0,0"
                        IsEnabled="{Binding UpdateValue}">
                    <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}">
                      <TextBox.Style>
                        <Style TargetType="TextBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTextEditor}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <ComboBox ItemsSource="{Binding SingleSelectOptions}"
                              SelectedItem="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}">
                      <ComboBox.Style>
                        <Style TargetType="ComboBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSingleSelectEditor}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ComboBox.Style>
                    </ComboBox>
                    <ItemsControl ItemsSource="{Binding MultiSelectOptions}">
                      <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMultiSelectEditor}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ItemsControl.Style>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Content="{Binding Value}"
                                    IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,4" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right">
                      <TextBox.Style>
                        <Style TargetType="TextBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNumberEditor}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <syncinput:SfDatePicker Value="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}"
                                            AllowNull="True"
                                            FormatString="d"
                                            Watermark="{loc:Loc SelectDate}">
                      <syncinput:SfDatePicker.Style>
                        <Style TargetType="syncinput:SfDatePicker">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDateEditor}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </syncinput:SfDatePicker.Style>
                    </syncinput:SfDatePicker>
                    <ComboBox SelectedValue="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag">
                      <ComboBox.Style>
                        <Style TargetType="ComboBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBooleanEditor}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ComboBox.Style>
                      <ComboBoxItem Content="" Tag="{x:Null}" />
                      <ComboBoxItem Content="{loc:Loc Yes}" Tag="True" />
                      <ComboBoxItem Content="{loc:Loc No}" Tag="False" />
                    </ComboBox>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="{loc:Loc MetadataMultiEditUncheckedFieldsHelp}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="300" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Content="{loc:Loc Save}"
                Command="{Binding ApplyCommand}"
                MinWidth="90"
                Padding="12,6"
                Margin="0,0,8,0"
                IsDefault="True" />
        <Button Content="{loc:Loc Cancel}"
                Command="{Binding CancelCommand}"
                MinWidth="90"
                Padding="12,6"
                IsCancel="True" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
