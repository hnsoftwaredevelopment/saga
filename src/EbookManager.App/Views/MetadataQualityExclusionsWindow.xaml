<Window x:Class="EbookManager.App.Views.MetadataQualityExclusionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc MetadataQualityExclusionsTitle}"
        Width="920"
        Height="520"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{loc:Loc MetadataQualityExclusionsTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc MetadataQualityExclusionsDescription}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Margin="0,8,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <Run Text="{Binding ExclusionCount, Mode=OneWay}" />
        <Run Text="{loc:Loc MetadataQualityExclusionsCountSuffix}" />
      </TextBlock>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button x:Name="RestoreSelectedQualityExclusionsButton"
              Content="{loc:Loc RestoreSelectedQualityExclusions}"
              Command="{Binding RestoreSelectedCommand}"
              MinWidth="150"
              Margin="0,0,8,0"
              Focusable="True"
              AutomationProperties.Name="{loc:Loc RestoreSelectedQualityExclusions}" />
      <Button x:Name="RestoreAllQualityExclusionsButton"
              Content="{loc:Loc RestoreAllQualityExclusions}"
              IsEnabled="{Binding HasRows}"
              MinWidth="130"
              Margin="0,0,8,0"
              Focusable="True"
              Click="RestoreAllClicked"
              AutomationProperties.Name="{loc:Loc RestoreAllQualityExclusions}" />
      <Button x:Name="CloseQualityExclusionsButton"
              Content="{loc:Loc Close}"
              MinWidth="90"
              IsCancel="True"
              Focusable="True"
              Click="CloseClicked"
              AutomationProperties.Name="{loc:Loc Close}" />
    </StackPanel>

    <Grid>
      <TextBlock x:Name="MetadataQualityExclusionsEmptyState"
                 Text="{loc:Loc MetadataQualityExclusionsNone}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasRows}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <DataGrid x:Name="MetadataQualityExclusionsGrid"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                SelectionChanged="MetadataQualityExclusionsSelectionChanged">
        <DataGrid.Style>
          <Style TargetType="DataGrid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasRows}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.Style>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc Title}" Binding="{Binding BookTitle}" Width="260" />
          <DataGridTextColumn Header="{loc:Loc Authors}" Binding="{Binding BookAuthors}" Width="220" />
          <DataGridTextColumn Header="{loc:Loc MetadataQualitySignal}" Binding="{Binding Signal}" Width="220" />
          <DataGridTextColumn Header="{loc:Loc DateAdded}" Binding="{Binding CreatedAt, StringFormat=d}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
