<Window x:Class="EbookManager.App.Views.MetadataQualityTagRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc MetadataQualityTagRepairTitle}"
        Width="620"
        Height="560"
        MinWidth="500"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{loc:Loc MetadataQualityTagRepairTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc MetadataQualityTagRepairDescription}"
                 Margin="0,5,0,16"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="CancelTagRepairButton"
              Content="{loc:Loc Cancel}"
              MinWidth="90"
              IsCancel="True"
              Focusable="True"
              AutomationProperties.Name="{loc:Loc Cancel}" />
      <Button x:Name="SaveTagRepairButton"
              Content="{loc:Loc MetadataQualityChangeTags}"
              MinWidth="110"
              Margin="8,0,0,0"
              IsDefault="True"
              IsEnabled="{Binding CanSave}"
              Focusable="True"
              Click="SaveClicked"
              AutomationProperties.Name="{loc:Loc MetadataQualityChangeTags}" />
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="3*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="{Binding BookTitle}"
                 Margin="0,0,0,14"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <TextBlock Grid.Row="1"
                 Text="{loc:Loc MetadataQualityCurrentTags}"
                 Margin="0,0,0,4"
                 FontWeight="SemiBold" />
      <TextBox x:Name="CurrentTagsOutput"
               Grid.Row="2"
               Text="{Binding CurrentTagsText, Mode=OneWay}"
               MinHeight="80"
               Padding="8"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Focusable="True"
               AutomationProperties.Name="{loc:Loc MetadataQualityCurrentTags}" />
      <TextBlock Grid.Row="3"
                 Text="{loc:Loc MetadataQualityNewTags}"
                 Margin="0,14,0,4"
                 FontWeight="SemiBold" />
      <TextBox x:Name="TagsInput"
               Grid.Row="4"
               Text="{Binding TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               MinHeight="130"
               Padding="8"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Loaded="TagsInputLoaded"
               Focusable="True"
               AutomationProperties.Name="{loc:Loc MetadataQualityNewTags}" />
      <TextBlock Grid.Row="5"
                 Text="{loc:Loc MetadataQualityTagRepairHelp}"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
  </DockPanel>
</Window>
