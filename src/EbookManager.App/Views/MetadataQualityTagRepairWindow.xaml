<Window x:Class="EbookManager.App.Views.MetadataQualityTagRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc MetadataQualityTagRepairTitle}"
        Width="620"
        Height="560"
        MinWidth="500"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="SingleTagEditor" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBulk}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BulkTagOverview" TargetType="DockPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBulk}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{loc:Loc MetadataQualityTagRepairTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Loc MetadataQualityTagRepairDescription}"
                 Margin="0,5,0,16"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBulk}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="CancelTagRepairButton"
              Content="{loc:Loc Cancel}"
              MinWidth="90"
              IsCancel="True"
              Focusable="True"
              AutomationProperties.Name="{loc:Loc Cancel}" />
      <Button x:Name="SaveTagRepairButton"
              MinWidth="110"
              Margin="8,0,0,0"
              IsDefault="True"
              IsEnabled="{Binding CanSave}"
              Focusable="True"
              Click="SaveClicked"
              AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="{loc:Loc MetadataQualityChangeTags}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBulk}" Value="True">
                <Setter Property="Content" Value="{Binding BulkSaveText}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </StackPanel>

    <Grid>
    <DockPanel Style="{StaticResource BulkTagOverview}">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Text="{Binding BulkContext}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc MetadataQualityTagRepairBulkHelp}" Margin="0,5,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox x:Name="TagPreviews"
               ItemsSource="{Binding Previews}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               HorizontalContentAlignment="Stretch"
               Focusable="True"
               AutomationProperties.Name="{loc:Loc MetadataQualityTagRepairBulkPreview}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="8">
              <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{loc:Loc MetadataQualityCurrentTags}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CurrentTagsText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{loc:Loc MetadataQualityNewTags}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding ProposedTagsText}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ProposedTagsText}" Value="">
                            <Setter Property="Text" Value="{loc:Loc MetadataQualityTagRepairEmptyTags}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Grid Style="{StaticResource SingleTagEditor}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="3*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="{Binding BookTitle}"
                 Margin="0,0,0,14"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <TextBlock Grid.Row="1"
                 Text="{loc:Loc MetadataQualityCurrentTags}"
                 Margin="0,0,0,4"
                 FontWeight="SemiBold" />
      <TextBox x:Name="CurrentTagsOutput"
               Grid.Row="2"
               Text="{Binding CurrentTagsText, Mode=OneWay}"
               MinHeight="80"
               Padding="8"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Focusable="True"
               AutomationProperties.Name="{loc:Loc MetadataQualityCurrentTags}" />
      <TextBlock Grid.Row="3"
                 Text="{loc:Loc MetadataQualityNewTags}"
                 Margin="0,14,0,4"
                 FontWeight="SemiBold" />
      <TextBox x:Name="TagsInput"
               Grid.Row="4"
               Text="{Binding TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               MinHeight="130"
               Padding="8"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Loaded="TagsInputLoaded"
               Focusable="True"
               AutomationProperties.Name="{loc:Loc MetadataQualityNewTags}" />
      <TextBlock Grid.Row="5"
                 Text="{loc:Loc MetadataQualityTagRepairHelp}"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
    </Grid>
  </DockPanel>
</Window>
