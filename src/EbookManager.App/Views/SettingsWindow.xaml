<Window x:Class="EbookManager.App.Views.SettingsWindow"
        x:Name="SettingsRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EbookManager.App.Converters"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        xmlns:settings="clr-namespace:EbookManager.Domain.Settings;assembly=EbookManager.Domain"
        xmlns:viewModels="clr-namespace:EbookManager.Presentation.ViewModels;assembly=EbookManager.Presentation"
        Title="{loc:Loc Settings}"
        Width="620"
        Height="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.Resources>
      <converters:LibraryColumnOptionToLocalizedStringConverter x:Key="LibraryColumnOptionToLocalizedStringConverter" />
      <converters:ResetViewTooltipConverter x:Key="ResetViewTooltipConverter" />
      <converters:LibraryViewDefinitionToLocalizedStringConverter x:Key="LibraryViewDefinitionToLocalizedStringConverter" />
      <converters:CustomMetadataFieldTypeToLocalizedStringConverter x:Key="CustomMetadataFieldTypeToLocalizedStringConverter" />
      <converters:LocalizationKeyToStringConverter x:Key="LocalizationKeyToStringConverter" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0">
      <TabItem Header="{loc:Loc SettingsGeneralSection}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="{loc:Loc Culture}" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,12,12" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    ItemsSource="{Binding SelectableCultures}"
                    DisplayMemberPath="DisplayName"
                    SelectedValue="{Binding Culture}"
                    SelectedValuePath="Value"
                    SelectionChanged="CultureSelectionChanged"
                    Margin="0,0,0,12" />
        </Grid>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsAppearanceSection}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="{loc:Loc Theme}" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,12,12" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    ItemsSource="{Binding SelectableThemes}"
                    SelectedItem="{Binding Theme}"
                    SelectionChanged="ThemeSelectionChanged"
                    Margin="0,0,0,12" />

          <TextBlock Text="{loc:Loc DefaultView}" Grid.Row="1" FontWeight="SemiBold" Margin="0,0,12,12" />
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    ItemsSource="{Binding LibraryViewModel.ViewDefinitions, ElementName=SettingsRoot}"
                    SelectedValue="{Binding DefaultView}"
                    SelectedValuePath="Id"
                    SelectionChanged="DefaultViewSelectionChanged"
                    Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LibraryViewDefinitionToLocalizedStringConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsViewsSection}">
        <Grid Margin="12"
              DataContext="{Binding LibraryViewModel, ElementName=SettingsRoot}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="{loc:Loc View}"
                     Grid.Row="0"
                     FontWeight="SemiBold"
                     Margin="0,0,12,12" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    ItemsSource="{Binding ViewDefinitions}"
                    SelectedValue="{Binding SelectedViewDefinitionId}"
                    SelectedValuePath="Id"
                    Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LibraryViewDefinitionToLocalizedStringConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{loc:Loc Columns}"
                     Grid.Row="1"
                     FontWeight="SemiBold"
                     Margin="0,0,12,12" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Text="{loc:Loc BookshelfUsesCoversOnly}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedView}" Value="Bookshelf">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <Border Grid.Row="2"
                  Grid.ColumnSpan="2">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ScrollViewer Grid.Row="0"
                            MaxHeight="230"
                            VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedView}" Value="Bookshelf">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ListBox ItemsSource="{Binding ColumnChoices}"
                         BorderThickness="0"
                         Background="Transparent"
                         AllowDrop="True"
                         DragOver="ColumnChoiceDragOver"
                         DragLeave="ColumnChoiceDragLeave"
                         Drop="ColumnChoiceDrop">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="AllowDrop" Value="True" />
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Padding" Value="0" />
                      <EventSetter Event="DragOver" Handler="ColumnChoiceDragOver" />
                      <EventSetter Event="DragLeave" Handler="ColumnChoiceDragLeave" />
                      <EventSetter Event="Drop" Handler="ColumnChoiceDrop" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="28"
                                Height="24"
                                Margin="0,0,8,0"
                                CornerRadius="4"
                                Background="{DynamicResource GridHeaderBackgroundBrush}"
                                ToolTip="{loc:Loc DragColumnTooltip}"
                                PreviewMouseMove="ColumnDragGripPreviewMouseMove">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Cursor" Value="SizeAll" />
                              <Setter Property="Opacity" Value="1" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                  <Setter Property="Cursor" Value="Arrow" />
                                  <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="☰"
                                     FontSize="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Command="{Binding LibraryViewModel.ToggleColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  VerticalAlignment="Center">
                          <TextBlock Text="{Binding Converter={StaticResource LibraryColumnOptionToLocalizedStringConverter}}" />
                        </CheckBox>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
              <WrapPanel Grid.Row="1"
                         Margin="0,12,0,0">
                <Button Command="{Binding CopyCurrentViewCommand}"
                        MinWidth="160"
                        Margin="0,0,8,0"
                        Padding="8,4"
                        ToolTip="{loc:Loc CopyViewTooltip}">
                  <TextBlock Text="{loc:Loc CopyView}" />
                </Button>
                <Button Command="{Binding RenameCurrentViewCommand}"
                        MinWidth="160"
                        Margin="0,0,8,0"
                        Padding="8,4"
                        ToolTip="{loc:Loc RenameViewTooltip}">
                  <TextBlock Text="{loc:Loc RenameView}" />
                </Button>
                <Button Command="{Binding DeleteCurrentViewCommand}"
                        MinWidth="160"
                        Margin="0,0,8,0"
                        Padding="8,4"
                        ToolTip="{loc:Loc DeleteViewTooltip}">
                  <TextBlock Text="{loc:Loc DeleteView}" />
                </Button>
                <Button Command="{Binding ResetCurrentViewLayoutCommand}"
                        MinWidth="160"
                        Padding="8,4">
                  <Button.ToolTip>
                    <MultiBinding Converter="{StaticResource ResetViewTooltipConverter}">
                      <Binding Source="{x:Static loc:LocalizedStrings.Current}" Path="[ResetViewTooltip]" />
                      <Binding Path="SelectedViewDefinition" />
                    </MultiBinding>
                  </Button.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16"
                             Height="16"
                             Margin="0,0,6,0">
                      <Grid Width="441"
                            Height="512.398">
                        <Path Data="{StaticResource ResetViewIconBackgroundGeometry}"
                              Fill="{DynamicResource AccentBrush}"
                              Stretch="None" />
                        <Path Data="{StaticResource ResetViewIconForegroundGeometry}"
                              Fill="{DynamicResource InfoBrush}"
                              Stretch="None" />
                      </Grid>
                    </Viewbox>
                    <TextBlock Text="{loc:Loc ResetView}" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsImportSection}">
        <StackPanel Margin="12">
          <CheckBox Content="{loc:Loc IncludeScanSubdirectoriesSetting}"
                    IsChecked="{Binding IncludeScanSubdirectories}"
                    Margin="0,0,0,12" />
        </StackPanel>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsMetadataSection}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="{loc:Loc AuthorSortStrategy}" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,12,12" />
          <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding AuthorSortStrategy}" SelectedValuePath="Tag" Margin="0,0,0,12">
            <ComboBoxItem Content="{loc:Loc AuthorSortDisplayName}" Tag="{x:Static settings:AuthorSortStrategy.DisplayName}" />
            <ComboBoxItem Content="{loc:Loc AuthorSortLastNameFirst}" Tag="{x:Static settings:AuthorSortStrategy.LastNameFirst}" />
            <ComboBoxItem Content="{loc:Loc AuthorSortLastNameFirstDutchPrefixes}" Tag="{x:Static settings:AuthorSortStrategy.LastNameFirstDutchPrefixes}" />
          </ComboBox>

          <TextBlock Text="{loc:Loc NormalizeLanguageMetadata}"
                     Grid.Row="1"
                     FontWeight="SemiBold"
                     Margin="0,0,12,12" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc NormalizeLanguageMetadataDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8" />
            <Button Content="{loc:Loc NormalizeLanguageMetadata}"
                    MinWidth="150"
                    HorizontalAlignment="Left"
                    Click="NormalizeLanguageMetadataClicked" />
          </StackPanel>

          <TextBlock Text="{loc:Loc CustomMetadataFields}"
                     Grid.Row="2"
                     FontWeight="SemiBold"
                     Margin="0,8,12,12" />
          <Grid Grid.Row="2"
                Grid.Column="1"
                Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{loc:Loc CustomMetadataFieldsDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8" />
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding CustomMetadataFields}"
                      SelectedItem="{Binding SelectedCustomMetadataField}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      MinHeight="90"
                      MaxHeight="145"
                      Margin="0,0,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Name}"
                                    Binding="{Binding Name}"
                                    Width="*" />
                <DataGridTemplateColumn Header="{loc:Loc Type}"
                                        Width="130">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Type, Converter={StaticResource CustomMetadataFieldTypeToLocalizedStringConverter}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc Key}"
                                    Binding="{Binding Key}"
                                    Width="140" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2"
                  Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding NewCustomMetadataFieldName, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,8,0"
                       ToolTip="{loc:Loc CustomMetadataNewFieldNameTooltip}" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding SelectableCustomMetadataFieldTypes}"
                        SelectedValue="{Binding NewCustomMetadataFieldType}"
                        SelectedValuePath="Value"
                        Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource CustomMetadataFieldTypeToLocalizedStringConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2"
                      Content="{loc:Loc Add}"
                      MinWidth="85"
                      Command="{Binding AddCustomMetadataFieldCommand}" />
            </Grid>
            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding CustomMetadataFieldName, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,8,0"
                       ToolTip="{loc:Loc CustomMetadataSelectedFieldNameTooltip}" />
              <Button Grid.Column="1"
                      Content="{loc:Loc Rename}"
                      MinWidth="85"
                      Margin="0,0,8,0"
                      Command="{Binding RenameCustomMetadataFieldCommand}" />
              <Button Grid.Column="2"
                      Content="{loc:Loc Delete}"
                      MinWidth="85"
                      Command="{Binding DeleteCustomMetadataFieldCommand}"
                      ToolTip="{loc:Loc CustomMetadataDeleteTooltip}" />
            </Grid>
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,8,0,0"
                    IsEnabled="{Binding CanEditCustomMetadataOptions}">
              <StackPanel>
                <TextBlock Text="{loc:Loc CustomMetadataOptions}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="{loc:Loc CustomMetadataOptionsDescription}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <TextBox Text="{Binding CustomMetadataOptionsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="72"
                         Margin="0,0,0,8" />
                <Button Content="{loc:Loc Save}"
                        MinWidth="85"
                        HorizontalAlignment="Left"
                        Command="{Binding SaveCustomMetadataOptionsCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="5"
                       Text="{Binding CustomMetadataStatusMessage, Converter={StaticResource LocalizationKeyToStringConverter}}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />
          </Grid>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsConfirmationsSection}">
        <StackPanel Margin="12">
          <CheckBox Content="{loc:Loc ConfirmDeleteSetting}"
                    IsChecked="{Binding ConfirmDelete}"
                    Margin="0,0,0,12" />
        </StackPanel>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsDuplicatesSection}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <CheckBox Content="{loc:Loc DuplicateExactMatchesOnlySetting}"
                    IsChecked="{Binding DuplicateExactMatchesOnly}"
                    Margin="0,0,0,8" />
          <TextBlock Text="{loc:Loc DuplicateExactMatchesOnlyDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,16" />
          <TextBlock Text="{loc:Loc DuplicateExclusionsSettingsTitle}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,6" />
          <TextBlock Text="{loc:Loc DuplicateExclusionsSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,8" />
          <Button Content="{loc:Loc ManageDuplicateExclusions}"
                  HorizontalAlignment="Left"
                  MinWidth="170"
                  Margin="0,0,0,16"
                  Command="{Binding LibraryViewModel.ShowDuplicateExclusionsCommand, ElementName=SettingsRoot}" />
          <TextBlock Text="{loc:Loc DuplicateMergeDefaults}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,6" />
          <TextBlock Text="{loc:Loc DuplicateMergeDefaultsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,12" />
          <UniformGrid Columns="2" Margin="0,0,0,8">
            <StackPanel Margin="0,0,12,10">
              <TextBlock Text="{loc:Loc Cover}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox SelectedValue="{Binding MergeDefaultCover}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc MergeActionNoAction}" Tag="{x:Static settings:DuplicateMergeDefaultAction.NoAction}" />
                <ComboBoxItem Content="{loc:Loc MergeActionCopy}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Copy}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{loc:Loc Authors}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox SelectedValue="{Binding MergeDefaultAuthors}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc MergeActionNoAction}" Tag="{x:Static settings:DuplicateMergeDefaultAction.NoAction}" />
                <ComboBoxItem Content="{loc:Loc MergeActionCopy}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Copy}" />
                <ComboBoxItem Content="{loc:Loc MergeActionMerge}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Merge}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,12,10">
              <TextBlock Text="{loc:Loc Tags}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox SelectedValue="{Binding MergeDefaultTags}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc MergeActionNoAction}" Tag="{x:Static settings:DuplicateMergeDefaultAction.NoAction}" />
                <ComboBoxItem Content="{loc:Loc MergeActionCopy}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Copy}" />
                <ComboBoxItem Content="{loc:Loc MergeActionMerge}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Merge}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{loc:Loc Description}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox SelectedValue="{Binding MergeDefaultDescription}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc MergeActionNoAction}" Tag="{x:Static settings:DuplicateMergeDefaultAction.NoAction}" />
                <ComboBoxItem Content="{loc:Loc MergeActionCopy}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Copy}" />
                <ComboBoxItem Content="{loc:Loc MergeActionMerge}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Merge}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,12,10">
              <TextBlock Text="{loc:Loc Publisher}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox SelectedValue="{Binding MergeDefaultPublisher}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc MergeActionNoAction}" Tag="{x:Static settings:DuplicateMergeDefaultAction.NoAction}" />
                <ComboBoxItem Content="{loc:Loc MergeActionCopy}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Copy}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{loc:Loc Language}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox SelectedValue="{Binding MergeDefaultLanguage}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc MergeActionNoAction}" Tag="{x:Static settings:DuplicateMergeDefaultAction.NoAction}" />
                <ComboBoxItem Content="{loc:Loc MergeActionCopy}" Tag="{x:Static settings:DuplicateMergeDefaultAction.Copy}" />
              </ComboBox>
            </StackPanel>
          </UniformGrid>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Loc SettingsDiagnosticsSection}">
        <StackPanel Margin="12">
          <CheckBox Content="{loc:Loc EnableDiagnosticDetailsSetting}"
                    IsChecked="{Binding EnableDiagnosticDetails}"
                    Margin="0,0,0,8" />
          <TextBlock Text="{loc:Loc EnableDiagnosticDetailsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="{loc:Loc Save}" MinWidth="90" Margin="0,0,8,0" Click="SaveClicked" />
      <Button Content="{loc:Loc Cancel}" MinWidth="90" Click="CancelClicked" />
    </StackPanel>
  </Grid>
</Window>
