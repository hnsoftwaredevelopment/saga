<Window x:Class="EbookManager.App.Views.AuthorMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EbookManager.App.Localization"
        Title="{loc:Loc AuthorMerge}" Width="720" Height="720" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources><Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style></Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ConfirmButton" Content="{loc:Loc AuthorMergeConfirm}" IsEnabled="{Binding CanMerge}" IsDefault="True" Click="ConfirmClicked" MinWidth="120" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc AuthorMergeConfirm}" />
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="90" AutomationProperties.Name="{loc:Loc Cancel}" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{loc:Loc AuthorMerge}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,8,0,12" />
        <ItemsControl ItemsSource="{Binding Authors}" MaxHeight="130">
          <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,2" TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding BookCount, Mode=OneWay}" /></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Label Content="{loc:Loc AuthorMergeTarget}" Target="{Binding ElementName=TargetBox}" Margin="0,12,0,0" Padding="0,0,0,4" />
        <ComboBox x:Name="TargetBox" ItemsSource="{Binding Authors}" SelectedItem="{Binding Target}" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Loc AuthorMergeTarget}" />
        <TextBlock Text="{loc:Loc AuthorMergeProfileHelp}" TextWrapping="Wrap" Margin="0,14,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Label Content="{loc:Loc AuthorBiography}" Target="{Binding ElementName=BiographyChoiceBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="BiographyChoiceBox" ItemsSource="{Binding BiographyOptions}" SelectedItem="{Binding BiographyChoice}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc AuthorBiography}" />
        <TextBlock Text="{Binding BiographyChoice.Value}" TextWrapping="Wrap" MaxHeight="100" Margin="0,4,0,10" />
        <Label Content="{loc:Loc AuthorWebsite}" Target="{Binding ElementName=WebsiteChoiceBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="WebsiteChoiceBox" ItemsSource="{Binding WebsiteOptions}" SelectedItem="{Binding WebsiteChoice}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc AuthorWebsite}" />
        <TextBlock Text="{Binding WebsiteChoice.Value}" TextWrapping="Wrap" Margin="0,4,0,10" />
        <Label Content="{loc:Loc AuthorPhoto}" Target="{Binding ElementName=PhotoChoiceBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="PhotoChoiceBox" ItemsSource="{Binding PhotoOptions}" SelectedItem="{Binding PhotoChoice}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc AuthorPhoto}" />
        <Image x:Name="PhotoPreview" Height="110" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc AuthorPhoto}" />
        <TextBlock x:Name="PhotoError" Text="{loc:Loc AuthorPhotoLoadFailed}" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
