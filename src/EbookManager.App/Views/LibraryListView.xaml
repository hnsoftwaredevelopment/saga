<UserControl x:Class="EbookManager.App.Views.LibraryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EbookManager.App.Controls"
             xmlns:converters="clr-namespace:EbookManager.App.Converters"
             xmlns:loc="clr-namespace:EbookManager.App.Localization"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             AllowDrop="True">
  <UserControl.Resources>
    <converters:LibraryGroupHeaderTextConverter x:Key="LibraryGroupHeaderTextConverter" />
    <converters:LibraryColumnGridLengthConverter x:Key="LibraryColumnGridLengthConverter" />
    <controls:BindingProxy x:Key="LibraryViewModelProxy" Data="{Binding}" />
    <Style x:Key="GroupedColumnHeaderTextStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style x:Key="StandardGridHeaderCellStyle" TargetType="syncfusion:GridHeaderCellControl">
      <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <DataTemplate x:Key="ListBookRowTemplate">
      <controls:LibraryColumnRowGrid MinHeight="34"
                                     Margin="0,0,0,1"
                                     Background="{DynamicResource PanelBackgroundBrush}"
                                     BookRow="{Binding}"
                                     LayoutSnapshot="{Binding DataContext.ActiveColumnLayoutSnapshot, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     MouseLeftButtonDown="BookRowMouseLeftButtonDown" />
    </DataTemplate>
    <DataTemplate x:Key="ListGroupNodeTemplate">
      <StackPanel Margin="0,0,0,4">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Content="{Binding}">
          <Expander.Style>
            <Style TargetType="Expander">
              <Setter Property="ContentTemplate" Value="{x:Null}" />
              <Style.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter Property="ContentTemplate" Value="{DynamicResource ListGroupContentTemplate}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Expander.Style>
          <Expander.Header>
            <TextBlock FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="{DynamicResource TextPrimaryBrush}">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LibraryGroupHeaderTextConverter}">
                  <Binding Path="Header" />
                  <Binding Path="BookCount" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Expander.Header>
        </Expander>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ListGroupContentTemplate">
      <Grid Margin="22,4,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Groups}"
                 ItemTemplate="{StaticResource ListGroupNodeTemplate}"
                 BorderThickness="0"
                 Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 controls:MouseWheelScrollAssist.BubbleToParent="True" />
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Books}"
                 ItemTemplate="{StaticResource ListBookRowTemplate}"
                 BorderThickness="0"
                 Background="Transparent"
                 controls:MouseWheelScrollAssist.BubbleToParent="True" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <syncfusion:SfDataGrid x:Name="BooksGrid"
                           ItemsSource="{Binding ListVisibleBooksSource}"
                           SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           AllowEditing="False"
                           AllowSorting="True"
                           AllowTriStateSorting="True"
                           AllowResizingColumns="True"
                           AllowGrouping="False"
                           ShowGroupDropArea="False"
                           NavigationMode="Row"
                           SelectionMode="Extended"
                           SelectionChanged="BooksGridSelectionChanged"
                           PreviewMouseRightButtonDown="BooksGridPreviewMouseRightButtonDown"
                           HeaderRowHeight="40"
                           HeaderStyle="{StaticResource StandardGridHeaderCellStyle}"
                           RowHeight="34"
                           AllowDrop="True">
      <syncfusion:SfDataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{Binding PlacementTarget.DataContext.MetadataMultiEditMenuHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    Command="{Binding PlacementTarget.DataContext.ShowMetadataMultiEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
      </syncfusion:SfDataGrid.ContextMenu>
      <syncfusion:SfDataGrid.Style>
        <Style TargetType="syncfusion:SfDataGrid">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsLibraryGrouped}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </syncfusion:SfDataGrid.Style>
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Title}"
                                       MappingName="Title"
                                       Width="260">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Title}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Authors}"
                                       MappingName="Authors"
                                       Width="220">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Authors}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Series}"
                                       MappingName="Series"
                                       Width="170">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Series}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc SeriesNumber}"
                                       MappingName="SeriesNumber"
                                       Width="110">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding SeriesNumberText}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Status}"
                                       MappingName="ReadingStatus"
                                       Width="120">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding ReadingStatus}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Language}"
                                       MappingName="Language"
                                       Width="130">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Language}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Type}"
                                       MappingName="Formats"
                                       Width="130">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Formats}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Publisher}"
                                       MappingName="Publisher"
                                       Width="170">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Publisher}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
      <syncfusion:GridTemplateColumn HeaderText="{loc:Loc PublicationDate}"
                                       MappingName="PublicationDateSortValue"
                                       Width="130">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding PublicationDate}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Tags}"
                                       MappingName="Tags"
                                       Width="220">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Tags}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Isbn}"
                                       MappingName="Isbn"
                                       Width="140">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Isbn}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc Description}"
                                       MappingName="Description"
                                       Width="320">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding Description}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc DateAdded}"
                                       MappingName="DateAddedSortValue"
                                       Width="150">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding DateAdded}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc LastModified}"
                                       MappingName="LastModifiedSortValue"
                                       Width="150">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding LastModified}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTemplateColumn HeaderText="{loc:Loc EReader}"
                                       MappingName="EReader"
                                       Width="120">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightedTextBlock HighlightedText="{Binding EReader}"
                                             SearchText="{Binding SearchText}"
                                             HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
      </syncfusion:SfDataGrid.Columns>
    </syncfusion:SfDataGrid>

    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsLibraryGrouped}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="1"
                SnapsToDevicePixels="True">
          <controls:LibraryColumnRowGrid MinHeight="40"
                                         IsHeader="True"
                                         View="List"
                                         LayoutSnapshot="{Binding ActiveColumnLayoutSnapshot}" />
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ListGroupedLibraryNodesSource}"
                 ItemTemplate="{StaticResource ListGroupNodeTemplate}"
                 BorderThickness="0"
                 Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Grid>
</UserControl>
